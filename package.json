{
  "name": "poker-training-pro",
  "version": "0.1.0",
  "private": true,
  "description": "A game-like desktop poker statistics trainer and tournament simulator.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "generate:persistence-contract": "node scripts/check-node-version.mjs && node scripts/generate-persistence-contract.mjs",
    "check:persistence-contract": "node scripts/check-node-version.mjs && node scripts/generate-persistence-contract.mjs --check",
    "check:runtime": "node scripts/check-node-version.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "node scripts/check-node-version.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "test": "node scripts/check-node-version.mjs && vitest run",
    "test:runtime": "node scripts/check-node-version.mjs && node --test scripts/runtime-version.test.mjs",
    "test:static-budgets": "node scripts/check-node-version.mjs && node --test scripts/audit-static-budgets.test.mjs",
    "build": "node scripts/check-node-version.mjs && tsc --noEmit && vite build",
    "assets:capture-table-previews": "node scripts/check-node-version.mjs && node scripts/capture-table-view-previews.mjs",
    "assets:build-table": "node scripts/check-node-version.mjs && blender --background --factory-startup --python tools/blender/build_table.py -- --out src/assets/table.glb && node tools/glb-to-geometry.mjs src/assets/table.glb src/scene3d/generated/tableGeometry.ts tableGeometry",
    "assets:build-characters": "node scripts/check-node-version.mjs && blender --background --factory-startup --python tools/blender/build_characters.py -- --out work/blender/characters.glb",
    "package:win": "node scripts/check-node-version.mjs && npm run build && electron-builder --win nsis portable --x64 --config.electronDist=node_modules/electron/dist && npm run release:audit-packaged-3d-scene && npm run release:audit-packaged-licenses",
    "release:verify": "node scripts/check-node-version.mjs && node scripts/release/run-release-verification.mjs",
    "release:asset-rights": "node scripts/check-node-version.mjs && node scripts/validate-asset-rights.mjs",
    "release:verify-fuses": "node scripts/check-node-version.mjs && node scripts/verify-electron-fuses.mjs",
    "release:test-asar-integrity": "node scripts/check-node-version.mjs && node scripts/test-asar-tamper-rejection.mjs",
    "release:audit-packaged-network": "node scripts/check-node-version.mjs && node scripts/audit-packaged-network.mjs",
    "release:audit-packaged-input": "node scripts/check-node-version.mjs && node scripts/audit-packaged-input-smoke.mjs",
    "release:audit-packaged-mode-completion": "node scripts/check-node-version.mjs && node scripts/audit-packaged-mode-completion.mjs",
    "release:audit-packaged-recovery": "node scripts/check-node-version.mjs && node scripts/audit-packaged-save-recovery-smoke.mjs",
    "release:audit-packaged-presentation": "node scripts/check-node-version.mjs && node scripts/audit-packaged-presentation-surfaces.mjs",
    "release:audit-packaged-lifecycle-load": "node scripts/check-node-version.mjs && node scripts/audit-packaged-lifecycle-load.mjs",
    "release:audit-packaged-scene3d": "node scripts/check-node-version.mjs && node scripts/audit-packaged-scene3d-fallback.mjs",
    "release:audit-packaged-3d-scene": "node scripts/check-node-version.mjs && node scripts/audit-packaged-3d-scene.mjs",
    "release:audit-packaged-screen-layout": "node scripts/check-node-version.mjs && node scripts/audit-packaged-screen-layout.mjs",
    "release:audit-packaged-lifecycle-security": "node scripts/check-node-version.mjs && node scripts/audit-packaged-lifecycle-bridge-security.mjs",
    "release:audit-packaged-licenses": "node scripts/check-node-version.mjs && node scripts/audit-packaged-license-sidecars.mjs",
    "release:verify-audio-rights": "node scripts/check-node-version.mjs && node scripts/validate-audio-rights.mjs",
    "release:verify-runtime-video-policy": "node scripts/check-node-version.mjs && node scripts/validate-runtime-video-policy.mjs",
    "release:test-packaged-licenses": "node scripts/check-node-version.mjs && node scripts/test-packaged-license-sidecars.mjs",
    "diagnose:motion": "node scripts/check-node-version.mjs && node scripts/diagnose-motion.mjs",
    "measure:ai": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/report-ai-behavior.ts --",
    "measure:normal-all-ins": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/report-normal-all-in-audit.ts --",
    "measure:exploitability": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/report-exploitability.ts --",
    "measure:critic": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/report-critic-harness.ts --",
    "release:audit-ai-behavior": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/audit-ai-behavior-gates.ts",
    "release:audit-exploitability": "node scripts/check-node-version.mjs && vite-node -c scripts/vite-node.config.mjs scripts/audit-exploitability-gates.ts"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.2",
    "@rolldown/binding-win32-x64-msvc": "1.1.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "^9.2.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.8.0",
    "vite": "8.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "pro.pokertraining.desktop",
    "productName": "Poker Training Pro",
    "asar": true,
    "directories": {
      "output": "outputs/next",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "licenses/**/*",
      "docs/privacy-policy.md",
      "THIRD-PARTY-NOTICES.packages.md",
      "THIRD-PARTY-NOTICES.runtime.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.runtime.txt",
        "to": "THIRD-PARTY-NOTICES.runtime.txt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
